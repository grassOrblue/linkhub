PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=http://192.168.1.20:8787
DATA_DIR=./data
MEDIA_DIR=./media
# 可选：ffmpeg.exe / ffprobe.exe 所在目录，留空则使用系统 PATH
FFMPEG_BIN_DIR=
ADMIN_BIND=127.0.0.1
ADMIN_TOKEN=
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
COPY_CRON=0 3 * * *
COPY_PER_STORE=6
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
# 可临时填写有效的官方 ticket；不是 app secret，过期后必须刷新
DOUYIN_SHARE_TICKET=
KUAISHOU_APP_ID=
KUAISHOU_APP_SECRET=
XHS_APP_KEY=
XHS_APP_SECRET=
# 必须是已实现 pages/post/post 且能读取本站素材接口的自有小程序
XHS_MINIAPP_ID=
