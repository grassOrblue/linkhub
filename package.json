{
  "name": "linkhub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "node --watch --import tsx server/src/index.ts",
    "build": "vite build web --outDir ../dist",
    "start": "node --import tsx server/src/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "node-cron": "^4.2.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
  }
}
